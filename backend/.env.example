# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# Long random string, e.g. `openssl rand -base64 48`. Required in production.
JWT_SECRET=

# HTTPS URL where SSLCommerz and the phone's browser can reach this server.
# For local testing, expose port 4000 with a tunnel (ngrok, cloudflared) and put that URL here.
PUBLIC_BASE_URL=http://localhost:4000

DATABASE_PATH=./data/clau.db

# SSLCommerz store credentials. Sandbox stores: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Hold payments SSLCommerz marks high risk (risk_level=1) for manual review.
SSLCOMMERZ_HOLD_RISKY=true

# Deep-link prefixes the payment result page may send users back to.
APP_REDIRECT_PREFIXES=clau://,exp://,exps://

# Comma-separated origins allowed to call the API from a browser (web build only).
CORS_ORIGINS=
